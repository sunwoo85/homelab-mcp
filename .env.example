# Homelab MCP — example configuration
# Copy to .env and edit as needed; .env is gitignored.
# All variables are optional. Defaults shown commented.

# ── Network ──────────────────────────────────────────────────────
# HOMELAB_MCP_HOST=0.0.0.0
# HOMELAB_MCP_PORT=1603

# ── Roots ────────────────────────────────────────────────────────
# Directories the server may read, glob, and grep within.
# Colon-separated, like $PATH. Defaults to $PWD when unset.
# HOMELAB_MCP_ROOTS=/home/me/projects:/home/me/services

# ── External services ────────────────────────────────────────────
# HOMELAB_MCP_SEARXNG=http://localhost:8080

# Tavily API key — https://app.tavily.com. Enables tavily as a search
# engine; by default it becomes the backup (web_search_backup) when set.
# HOMELAB_MCP_TAVILY_KEY=tvly-xxxxxxxx

# Exa API key — https://dashboard.exa.ai. When set, the web_search_semantic
# tool is registered: neural search by meaning, for conceptual and
# discovery queries. Unset → tool not exposed.
# HOMELAB_MCP_EXA_KEY=xxxxxxxx

# Telegram bot — enables the send_message tool (notify the homelab owner).
# Both must be set. Token from @BotFather; chat ID via getUpdates — see
# README → Telegram setup.
# HOMELAB_MCP_TELEGRAM_TOKEN=123456789:xxxxxxxx
# HOMELAB_MCP_TELEGRAM_CHAT_ID=123456789

# ── Search engine roles ──────────────────────────────────────────
# Which engine backs web_search (primary) and web_search_backup (backup).
# Choices: searxng, tavily (backup also: none). Defaults: searxng primary
# with tavily backup iff its key is set; tavily primary defaults the
# backup to searxng. Same engine twice, or tavily without its key as
# primary, refuses to start.
# HOMELAB_MCP_SEARCH_PRIMARY=searxng
# HOMELAB_MCP_SEARCH_BACKUP=tavily

# Absolute path to the Claude CLI binary, only needed when 'claude'
# isn't on the service's $PATH (e.g. installed in ~/.local/bin under a
# systemd --user unit).
# HOMELAB_MCP_CLAUDE_BIN=/home/me/.local/bin/claude

# ── Limits ───────────────────────────────────────────────────────
# HOMELAB_MCP_MAX_FILE_BYTES=10485760
# HOMELAB_MCP_GLOB_LIMIT=200
# HOMELAB_MCP_GREP_LIMIT=50
# HOMELAB_MCP_SEARCH_LIMIT=20
# HOMELAB_MCP_FETCH_MAX_CHARS=50000
# HOMELAB_MCP_DOC_MAX_CHARS=200000

# ── Skip dirs (replaces default if set) ──────────────────────────
# HOMELAB_MCP_SKIP_DIRS=venv,.venv,node_modules,__pycache__,.git,.cache
