# Homelab MCP — example configuration
# Copy to .env and edit as needed; .env is gitignored.
# All variables are optional. Defaults shown commented.

# ── Network ──────────────────────────────────────────────────────
# HOMELAB_MCP_HOST=0.0.0.0
# HOMELAB_MCP_PORT=1603

# ── Roots ────────────────────────────────────────────────────────
# Directories the server may read, glob, and grep within.
# Colon-separated, like $PATH. Defaults to $PWD when unset.
# HOMELAB_MCP_ROOTS=/home/me/projects:/home/me/services

# ── External services ────────────────────────────────────────────
# HOMELAB_MCP_SEARXNG=http://localhost:8080

# Absolute path to the Claude CLI binary, only needed when 'claude'
# isn't on the service's $PATH (e.g. installed in ~/.local/bin under a
# systemd --user unit).
# HOMELAB_MCP_CLAUDE_BIN=/home/me/.local/bin/claude

# ── Limits ───────────────────────────────────────────────────────
# HOMELAB_MCP_MAX_FILE_BYTES=10485760
# HOMELAB_MCP_GLOB_LIMIT=200
# HOMELAB_MCP_GREP_LIMIT=50
# HOMELAB_MCP_SEARCH_LIMIT=20
# HOMELAB_MCP_FETCH_MAX_CHARS=50000
# HOMELAB_MCP_DOC_MAX_CHARS=200000

# ── Skip dirs (replaces default if set) ──────────────────────────
# HOMELAB_MCP_SKIP_DIRS=venv,.venv,node_modules,__pycache__,.git,.cache
